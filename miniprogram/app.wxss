/* 全局样式：延续「朝暮」粉色主题 */
page {
  --brand: #ff6b9d;
  --brand-2: #a78bfa;
  --brand-soft: #fff0f5;
  --bg: #fff7fa;
  --bg-2: #f6eef2;
  --card: #ffffff;
  --text: #3d2430;
  --text-dim: #b08e9c;
  --border: #f3e2e9;
  --r-sm: 12px;
  --r-md: 18px;
  background: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

.card {
  background: var(--card);
  border-radius: var(--r-md);
  padding: 24rpx;
  box-shadow: 0 10rpx 30rpx -18rpx rgba(122, 31, 67, .25);
  margin: 0 24rpx 24rpx;
}

.btn {
  display: flex; align-items: center; justify-content: center;
  height: 88rpx; border-radius: 44rpx;
  font-size: 30rpx; font-weight: 700;
  border: none; line-height: 88rpx;
}
.btn::after { border: none; }
.btn-primary {
  color: #fff;
  background: linear-gradient(135deg, var(--brand), var(--brand-2));
  box-shadow: 0 10rpx 24rpx -10rpx rgba(255, 107, 157, .6);
}
.btn-ghost {
  color: var(--brand);
  background: var(--brand-soft);
}
.btn-block { width: 100%; }
.btn-sm { height: 64rpx; line-height: 64rpx; padding: 0 24rpx; font-size: 24rpx; border-radius: 32rpx; width: auto; display: inline-flex; }
.btn[disabled] { opacity: .55; color: #fff; }

.field { margin-bottom: 26rpx; }
.field-label { font-size: 24rpx; font-weight: 700; color: var(--text-dim); margin-bottom: 10rpx; display: block; }
.input, .textarea {
  background: var(--bg-2);
  border-radius: var(--r-sm);
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  width: auto;
}
.textarea { width: auto; min-height: 160rpx; }

.chips { display: flex; flex-wrap: wrap; gap: 14rpx; }
.chip {
  padding: 10rpx 26rpx; border-radius: 999rpx;
  background: var(--card); border: 2rpx solid var(--border);
  font-size: 24rpx; font-weight: 600; color: var(--text-dim);
}
.chip.on { background: var(--brand-soft); border-color: var(--brand); color: var(--brand); }

.empty { text-align: center; color: var(--text-dim); font-size: 26rpx; padding: 80rpx 0; }
.empty .emoji { font-size: 72rpx; display: block; margin-bottom: 16rpx; }

.avatar { border-radius: 50%; background: var(--brand-soft); display: flex; align-items: center; justify-content: center; color: var(--brand); font-weight: 800; overflow: hidden; }
.avatar-sm { width: 72rpx; height: 72rpx; font-size: 30rpx; }
.avatar-lg { width: 128rpx; height: 128rpx; font-size: 52rpx; }
.avatar image { width: 100%; height: 100%; }

.section-title { font-size: 26rpx; font-weight: 800; color: var(--text-dim); margin: 8rpx 32rpx 16rpx; display: flex; justify-content: space-between; }
