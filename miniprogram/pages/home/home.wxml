<view class="cover-wrap">
  <view class="cover">
    <view class="tape butter"></view>
    <view class="pair">
      <view class="polaroid tilt-l photo-s">
        <image wx:if="{{book.myAvatar}}" src="{{book.myAvatar}}" mode="aspectFill" />
        <view wx:else class="ph-face">{{book.myName[0]}}</view>
        <text class="ph-name">{{book.myName}}</text>
      </view>
      <text class="heart-sticker">❤️</text>
      <view class="polaroid tilt-r photo-s">
        <image wx:if="{{book.partnerAvatar}}" src="{{book.partnerAvatar}}" mode="aspectFill" />
        <view wx:else class="ph-face">{{book.partnerName[0]}}</view>
        <text class="ph-name">{{book.partnerName}}</text>
      </view>
    </view>
    <view class="days-row">
      <text class="days-n">{{days}}</text>
      <text class="days-u">天在一起</text>
    </view>
    <view class="since">— 始于 {{book.anniversary}} —</view>
    <button class="miss-btn" bindtap="sendMiss">💗 想你</button>
    <view wx:if="{{partnerMiss}}" class="miss-bubble">TA 今天想了你 {{partnerMiss}} 次 💗</view>
    <view wx:if="{{!partnerJoined}}" class="code-card" bindtap="copyCode">
      <view class="tape lilac"></view>
      <text class="code-label">✂️ 邀请码（点击复制）</text>
      <text class="code">{{code}}</text>
      <text class="code-hint">把 TA 叫进来一起写呀</text>
    </view>
  </view>
  <text class="doodle doodle-1">✿</text>
  <text class="doodle doodle-2">☁️</text>
</view>

<!-- 今日一问：气泡 -->
<view class="card block-card">
  <view class="tape"></view>
  <view class="sticker-title pink" bindtap="goDaily">💬 今日一问 <text class="sticker-more">回顾 ›</text></view>
  <view class="dq-q">{{daily.question}}</view>
  <view class="bubble" bindtap="goDaily">
    <view class="tail"></view>
    <text class="dq-tag">我</text>
    <text class="dq-ans {{dailyMine ? '' : 'dim'}}">{{dailyMine || '还没回答，点这里写'}}</text>
  </view>
  <view class="bubble tail-right" style="margin: 16rpx 0 0 60rpx">
    <text class="dq-tag ta">TA</text>
    <text class="dq-ans dim">{{dailyPartner || '还没回答'}}</text>
  </view>
</view>

<!-- 重要日子 -->
<view class="section-head">
  <view class="sticker-title mint">📅 重要日子</view>
  <text class="section-more" bindtap="goEvents">管理 ›</text>
</view>
<view class="card">
  <view class="event-row" wx:for="{{events}}" wx:key="id">
    <text class="event-icon">{{item.icon}}</text>
    <view class="event-main">
      <view class="event-name">{{item.name}}</view>
      <view class="event-date">{{item.dateShort}}{{item.label ? ' · ' + item.label : ''}}</view>
    </view>
    <text class="event-count {{item.isToday ? 'today' : ''}}">{{item.text}}</text>
  </view>
  <view wx:if="{{!events.length}}" class="mini-empty">还没有重要日子，点「管理」加一个吧</view>
</view>

<!-- 心愿清单 -->
<view class="card block-card" bindtap="goWishes">
  <view class="tape mint"></view>
  <view class="card-head">
    <view class="sticker-title lilac">⭐ 心愿清单</view>
    <text class="card-link">{{wishDone}} / {{wishTotal}} 已完成</text>
  </view>
  <view class="wish-bar"><view class="wish-fill" style="width:{{wishPct}}%"></view></view>
  <view class="card-sub" wx:if="{{wishLatest}}">最近想一起：{{wishLatest}}</view>
  <view class="card-sub" wx:else>把想一起做的事都写下来</view>
</view>

<!-- 纠结转盘 -->
<view class="card block-card" bindtap="goWheel">
  <view class="tape butter"></view>
  <view class="card-head">
    <view class="sticker-title pink">🥺 选择困难症发作？</view>
    <text class="card-arrow">›</text>
  </view>
  <view class="card-sub">吃什么、去哪玩…让转盘帮你们决定</view>
</view>

<!-- 最近的小日子 -->
<view class="section-head">
  <view class="sticker-title">📖 最近的小日子</view>
  <text class="section-more" bindtap="goTimeline">全部 ›</text>
</view>
<view class="card rec" wx:for="{{latest}}" wx:key="_id">
  <view class="rec-head">
    <text class="mood">{{item.mood}}</text>
    <view class="rec-meta">
      <view class="rec-title" wx:if="{{item.title}}">{{item.title}}</view>
      <view class="rec-date">{{item.dateText}}</view>
      <view class="rec-author" wx:if="{{item.authorName}}">✍️ {{item.authorName}}{{item.place ? ' · 📍' + item.place : ''}}</view>
    </view>
  </view>
  <view class="rec-note" wx:if="{{item.note}}">{{item.note}}</view>
  <view wx:if="{{item.cover}}" class="polaroid {{index % 2 ? 'tilt-r' : 'tilt-l'}} rec-photo">
    <image src="{{item.cover}}" mode="aspectFill" lazy-load />
  </view>
  <view class="rec-foot">
    <view class="foot-btn">❤️<text wx:if="{{item.likeCount}}">{{item.likeCount}}</text></view>
    <view class="foot-btn">💬<text wx:if="{{item.commentCount}}">{{item.commentCount}}</text></view>
  </view>
</view>
<view wx:if="{{!latest.length}}" class="empty">
  <text class="emoji">🌱</text>
  <text>还没有记录，写下第一条吧</text>
</view>

<view class="fab" bindtap="goCompose">＋</view>

<view class="rain" wx:if="{{rainHearts.length}}">
  <text wx:for="{{rainHearts}}" wx:key="index" class="rain-heart"
        style="left:{{item.left}}%;animation-delay:{{item.delay}}s;font-size:{{item.size}}rpx">{{item.emoji}}</text>
</view>
