.page { padding: 24rpx 0 60rpx; }
.row { display: flex; gap: 14rpx; align-items: center; }
.grow { flex: 1; }

.wish { display: flex; align-items: center; gap: 18rpx; padding: 22rpx 24rpx; }
.check {
  width: 44rpx; height: 44rpx; border-radius: 12rpx;
  border: 3rpx solid var(--border);
  display: flex; align-items: center; justify-content: center;
  font-size: 26rpx; color: #fff; flex: none;
}
.check.on { background: linear-gradient(135deg, var(--brand), var(--brand-2)); border-color: transparent; }
.wish-text { flex: 1; font-size: 27rpx; }
.wish-text.done { color: var(--text-dim); text-decoration: line-through; }
.del { color: var(--text-dim); padding: 6rpx 10rpx; font-size: 26rpx; }
