.page { padding: 24rpx 0 60rpx; }
.q-label { font-size: 22rpx; color: var(--text-dim); }
.q-text { font-size: 32rpx; font-weight: 800; margin: 10rpx 0 24rpx; line-height: 1.5; }

.partner-ans {
  margin-top: 22rpx; padding: 18rpx 22rpx;
  background: var(--brand-soft); border-radius: var(--r-sm);
  display: flex; flex-direction: column; gap: 8rpx;
}
.partner-ans.dim { color: var(--text-dim); font-size: 22rpx; text-align: center; }
.pa-name { font-size: 22rpx; font-weight: 700; color: var(--brand); }
.pa-text { font-size: 26rpx; line-height: 1.6; }

.his { margin-bottom: 20rpx; }
.his-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 16rpx; }
.his-q { font-size: 26rpx; font-weight: 700; flex: 1; }
.his-date { font-size: 20rpx; color: var(--text-dim); flex: none; }
.his-mine { margin-top: 12rpx; font-size: 24rpx; line-height: 1.6; }
.his-partner {
  margin-top: 10rpx; font-size: 24rpx; line-height: 1.6;
  color: var(--brand); background: var(--brand-soft);
  border-radius: 10rpx; padding: 10rpx 14rpx;
}
