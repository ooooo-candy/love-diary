.page { padding: 40rpx 0 60rpx; }
.hero { text-align: center; margin: 30rpx 0 40rpx; }
.hero .emoji { font-size: 96rpx; line-height: 1; }
.hero .title { font-size: 40rpx; font-weight: 800; margin-top: 16rpx; }
.hero .desc { font-size: 24rpx; color: var(--text-dim); margin-top: 10rpx; line-height: 1.6; }

.tabs { justify-content: center; margin-bottom: 30rpx; }

.code-input {
  letter-spacing: 12rpx;
  text-align: center;
  font-size: 40rpx;
  font-weight: 800;
}
.picker { line-height: 1.4; }
