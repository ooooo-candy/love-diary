.page { padding: 40rpx 0 60rpx; }
.hero { text-align: center; margin: 30rpx auto 40rpx; width: 320rpx; }
.hero-pola { padding-bottom: 16rpx; }
.hero-emoji { font-size: 100rpx; line-height: 1.2; }
.hero .title { font-size: 38rpx; font-weight: 800; margin-top: 20rpx; }
.hero .desc { font-size: 24rpx; color: var(--text-dim); margin-top: 10rpx; line-height: 1.6; }

.tabs { justify-content: center; margin-bottom: 30rpx; }

.code-input {
  letter-spacing: 12rpx;
  text-align: center;
  font-size: 40rpx;
  font-weight: 800;
}
.picker { line-height: 1.4; }
.scan-btn { margin-top: 16rpx; }
.import-link {
  margin-top: 24rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--brand);
  padding: 10rpx 0;
}
