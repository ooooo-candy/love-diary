.page { padding: 24rpx 0 60rpx; }
.event-row { display: flex; align-items: center; gap: 18rpx; padding: 14rpx 0; }
.event-row:last-child { padding-bottom: 0; }
.event-icon { font-size: 40rpx; }
.event-main { flex: 1; min-width: 0; }
.event-name { font-size: 27rpx; font-weight: 700; }
.event-date { font-size: 21rpx; color: var(--text-dim); margin-top: 2rpx; }
.mini-op { font-size: 30rpx; padding: 6rpx; opacity: .7; }
.add-btn { margin-top: 10rpx; }
.hint { font-size: 22rpx; color: var(--text-dim); text-align: center; margin-top: 18rpx; line-height: 1.6; }
.mini-empty { font-size: 23rpx; color: var(--text-dim); text-align: center; padding: 16rpx 0; }

.mask {
  position: fixed; inset: 0;
  background: rgba(30, 12, 24, .45);
  z-index: 100;
  display: flex; align-items: flex-end;
}
.sheet {
  width: 100%; background: var(--bg);
  border-radius: 30rpx 30rpx 0 0;
  padding: 34rpx 34rpx calc(34rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  max-height: 85vh; overflow-y: auto;
}
.sheet-title { text-align: center; font-size: 30rpx; font-weight: 800; margin-bottom: 24rpx; }
.icon-chip { font-size: 34rpx; padding: 8rpx 20rpx; }
.switch-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 16rpx 4rpx; margin-bottom: 10rpx;
  font-size: 26rpx; font-weight: 600;
}
