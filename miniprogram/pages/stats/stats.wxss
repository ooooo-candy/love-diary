.page { padding: 30rpx 0 60rpx; }

.me-card { display: flex; align-items: center; gap: 18rpx; padding-top: 34rpx; }
.me-card .btn { margin-left: auto; }
.me-main { flex: 1; min-width: 0; }
.me-name { font-size: 30rpx; font-weight: 800; }
.me-sub { font-size: 22rpx; color: var(--ink-dim); margin-top: 4rpx; }

.partner-card { position: relative; padding-top: 34rpx; padding-bottom: 46rpx; }
.dot-sticker { font-size: 36rpx; transform: rotate(8deg); }
.love-line {
  position: absolute; left: 0; right: 0; bottom: 14rpx;
  text-align: center; font-size: 21rpx; color: var(--pink-deep);
}

.grid { display: flex; flex-wrap: wrap; gap: 18rpx; margin: 0 24rpx 30rpx; }
.cell {
  width: calc(50% - 9rpx); box-sizing: border-box;
  background: var(--card);
  border: 2rpx solid var(--line);
  border-radius: 26rpx 30rpx 24rpx 30rpx;
  padding: 30rpx 26rpx;
  box-shadow: var(--shadow);
  text-align: left;
}
.cell .n { font-size: 56rpx; font-weight: 900; color: var(--pink-deep); }
.cell .l { font-size: 22rpx; color: var(--ink-dim); margin-top: 6rpx; font-weight: 700; }
.hero-cell {
  background: var(--pink-soft);
  border-color: var(--pink);
}
.hero-cell .n { color: var(--pink-deep); text-shadow: 2rpx 3rpx 0 #fff; }
.hero-cell .l { color: var(--ink); }

.mood-row { display: flex; align-items: center; gap: 18rpx; padding: 12rpx 0; }
.mood-emoji { font-size: 36rpx; width: 52rpx; text-align: center; flex: none; }
.mood-track {
  flex: 1; height: 20rpx; border-radius: 999rpx;
  background: var(--bg-2);
  border: 2rpx dashed var(--line);
  overflow: hidden;
}
.mood-fill {
  height: 100%; border-radius: 999rpx;
  background: repeating-linear-gradient(45deg, var(--pink), var(--pink) 10rpx, #ffa585 10rpx, #ffa585 20rpx);
}
.mood-n { width: 48rpx; text-align: right; font-size: 25rpx; font-weight: 800; color: var(--ink-dim); flex: none; }

.cal-week { display: flex; margin-bottom: 8rpx; }
.cal-week text { flex: 1; text-align: center; font-size: 20rpx; color: var(--ink-dim); font-weight: 700; }
.cal-grid { display: flex; flex-wrap: wrap; }
.cal-cell {
  width: 14.28%; text-align: center;
  padding: 10rpx 0; font-size: 23rpx; box-sizing: border-box;
  color: var(--ink);
}
.cal-cell.has { font-weight: 800; color: var(--pink-deep); }
.cal-cell.has::after {
  content: '❤';
  display: block;
  font-size: 14rpx;
  line-height: 1;
  margin-top: 2rpx;
}
.cal-cell.today {
  background: var(--butter-soft);
  border: 2rpx dashed var(--butter);
  border-radius: 12rpx;
  font-weight: 800;
}
.cal-hint { font-size: 20rpx; color: var(--ink-dim); text-align: center; margin-top: 12rpx; }

.invite {
  background: var(--pink-soft);
  border: 3rpx dashed var(--pink);
  border-radius: var(--r-sm);
  color: var(--ink); text-align: center;
  padding: 24rpx;
  display: flex; flex-direction: column; gap: 6rpx;
}
.i-label { font-size: 22rpx; color: var(--pink-deep); font-weight: 700; }
.i-code { font-size: 56rpx; font-weight: 900; letter-spacing: 14rpx; color: var(--pink-deep); }
.i-hint { font-size: 20rpx; color: var(--ink-dim); }
.invite-actions { display: flex; gap: 14rpx; margin-top: 18rpx; }
.invite-actions .btn { flex: 1; }

.mig-card { display: flex; align-items: center; gap: 18rpx; }
.mig-emoji { font-size: 48rpx; }
.mig-main { flex: 1; min-width: 0; }
.mig-title { font-size: 27rpx; font-weight: 800; }
.mig-sub { font-size: 21rpx; color: var(--ink-dim); margin-top: 4rpx; }

.foot { text-align: center; font-size: 20rpx; color: var(--ink-dim); margin-top: 24rpx; }

.mask {
  position: fixed; inset: 0;
  background: rgba(90, 70, 82, .45);
  z-index: 100;
  display: flex; align-items: flex-end;
}
.sheet {
  position: relative;
  width: 100%; background: var(--bg);
  border-radius: 36rpx 36rpx 0 0;
  padding: 44rpx 34rpx calc(34rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  max-height: 85vh; overflow-y: auto;
}
.sheet-title { text-align: center; font-size: 30rpx; font-weight: 800; margin-bottom: 24rpx; }
.avatar-edit { display: flex; flex-direction: column; align-items: center; gap: 12rpx; margin-bottom: 24rpx; }
.avatar-pola { width: 200rpx; padding: 10rpx 10rpx 30rpx; transform: rotate(2deg); }
.ph-face-big {
  width: 176rpx; height: 176rpx; border-radius: 8rpx;
  background: var(--pink-soft);
  display: flex; align-items: center; justify-content: center;
  color: var(--pink-deep); font-size: 64rpx; font-weight: 800;
  overflow: hidden;
}
.ph-face-big image { width: 100%; height: 100%; }
.avatar-tip { font-size: 20rpx; color: var(--ink-dim); }

.qr-sheet { display: flex; flex-direction: column; align-items: center; }
.qr-pola { width: 460rpx; margin: 10rpx 0 16rpx; transform: rotate(-1.5deg); }
.qr-img { width: 100%; height: 400rpx; }
.qr-hint { font-size: 22rpx; color: var(--ink-dim); margin-bottom: 20rpx; }
.close-btn { margin-top: 14rpx; }
