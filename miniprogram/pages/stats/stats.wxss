.page { padding: 24rpx 0 60rpx; }

.me-card { display: flex; align-items: center; gap: 18rpx; }
.me-card .btn { margin-left: auto; }
.me-main { flex: 1; min-width: 0; }
.me-name { font-size: 30rpx; font-weight: 800; }
.me-sub { font-size: 22rpx; color: var(--text-dim); margin-top: 4rpx; }

.partner-card { position: relative; padding-bottom: 40rpx; }
.online-dot {
  display: inline-flex; align-items: center; gap: 6rpx;
  font-size: 20rpx; font-weight: 700; color: var(--text-dim);
  border: 1rpx solid var(--border); border-radius: 999rpx;
  padding: 6rpx 16rpx; flex: none;
}
.online-dot i { width: 12rpx; height: 12rpx; border-radius: 50%; background: #c9c9c9; }
.love-line {
  position: absolute; left: 0; right: 0; bottom: 14rpx;
  text-align: center; font-size: 21rpx; color: var(--brand);
}

.grid { display: flex; flex-wrap: wrap; gap: 16rpx; margin: 0 24rpx 24rpx; }
.cell {
  width: calc(50% - 8rpx); box-sizing: border-box;
  background: var(--card);
  border-radius: var(--r-md); padding: 30rpx 26rpx;
  box-shadow: 0 10rpx 30rpx -18rpx rgba(122, 31, 67, .25);
}
.cell .n { font-size: 52rpx; font-weight: 900; }
.cell .l { font-size: 22rpx; color: var(--text-dim); margin-top: 6rpx; }
.hero-cell {
  background: linear-gradient(135deg, var(--brand), var(--brand-2));
  color: #fff;
  box-shadow: 0 14rpx 34rpx -14rpx rgba(255, 107, 157, .7);
}
.hero-cell .l { color: rgba(255,255,255,.85); }

.mood-row { display: flex; align-items: center; gap: 18rpx; padding: 12rpx 0; }
.mood-emoji { font-size: 34rpx; width: 48rpx; text-align: center; flex: none; }
.mood-track { flex: 1; height: 14rpx; border-radius: 999rpx; background: var(--bg-2); overflow: hidden; }
.mood-fill {
  height: 100%; border-radius: 999rpx;
  background: linear-gradient(90deg, var(--brand), var(--brand-2));
  transition: width .4s ease;
}
.mood-n { width: 48rpx; text-align: right; font-size: 24rpx; font-weight: 700; color: var(--text-dim); flex: none; }

.cal-week {
  display: flex; margin-bottom: 8rpx;
}
.cal-week text { flex: 1; text-align: center; font-size: 20rpx; color: var(--text-dim); }
.cal-grid { display: flex; flex-wrap: wrap; }
.cal-cell {
  width: 14.28%; text-align: center;
  padding: 10rpx 0; font-size: 23rpx; box-sizing: border-box;
  color: var(--text);
}
.cal-cell.has { font-weight: 800; color: var(--brand); }
.cal-cell.has::after {
  content: ''; display: block;
  width: 8rpx; height: 8rpx; border-radius: 50%;
  background: var(--brand); margin: 4rpx auto 0;
}
.cal-cell.today {
  background: var(--brand-soft);
  border-radius: 10rpx;
  font-weight: 800;
}
.cal-hint { font-size: 20rpx; color: var(--text-dim); text-align: center; margin-top: 10rpx; }

.invite {
  background: linear-gradient(135deg, var(--brand), var(--brand-2));
  border-radius: var(--r-sm);
  color: #fff; text-align: center;
  padding: 24rpx;
  display: flex; flex-direction: column; gap: 6rpx;
}
.i-label { font-size: 22rpx; opacity: .9; }
.i-code { font-size: 52rpx; font-weight: 900; letter-spacing: 14rpx; }
.i-hint { font-size: 20rpx; opacity: .85; }
.invite-actions { display: flex; gap: 14rpx; margin-top: 16rpx; }
.invite-actions .btn { flex: 1; }

.mig-card { display: flex; align-items: center; gap: 18rpx; }
.mig-emoji { font-size: 48rpx; }
.mig-main { flex: 1; min-width: 0; }
.mig-title { font-size: 27rpx; font-weight: 800; }
.mig-sub { font-size: 21rpx; color: var(--text-dim); margin-top: 4rpx; }

.foot { text-align: center; font-size: 20rpx; color: var(--text-dim); margin-top: 20rpx; }

.mask {
  position: fixed; inset: 0;
  background: rgba(30, 12, 24, .45);
  z-index: 100;
  display: flex; align-items: flex-end;
}
.sheet {
  width: 100%; background: var(--bg);
  border-radius: 30rpx 30rpx 0 0;
  padding: 34rpx 34rpx calc(34rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  max-height: 85vh; overflow-y: auto;
}
.sheet-title { text-align: center; font-size: 30rpx; font-weight: 800; margin-bottom: 24rpx; }
.avatar-edit { display: flex; flex-direction: column; align-items: center; gap: 8rpx; margin-bottom: 20rpx; }
.avatar-tip { font-size: 20rpx; color: var(--text-dim); }

.qr-sheet { display: flex; flex-direction: column; align-items: center; }
.qr-img { width: 420rpx; height: 420rpx; margin: 10rpx 0 16rpx; background: #fff; border-radius: 20rpx; }
.qr-hint { font-size: 22rpx; color: var(--text-dim); margin-bottom: 20rpx; }
.close-btn { margin-top: 14rpx; }
