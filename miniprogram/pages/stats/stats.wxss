.page { padding: 24rpx 0 60rpx; }

.me-card { display: flex; align-items: center; gap: 18rpx; }
.me-main { flex: 1; min-width: 0; }
.me-name { font-size: 30rpx; font-weight: 800; }
.me-sub { font-size: 22rpx; color: var(--text-dim); margin-top: 4rpx; }

.stat-row {
  display: flex; gap: 16rpx;
  margin: 0 24rpx 24rpx;
}
.stat {
  flex: 1; background: var(--card);
  border-radius: var(--r-md); padding: 26rpx 0;
  text-align: center;
  box-shadow: 0 10rpx 30rpx -18rpx rgba(122, 31, 67, .25);
}
.stat .n { font-size: 44rpx; font-weight: 900; color: var(--brand); }
.stat .l { font-size: 22rpx; color: var(--text-dim); margin-top: 4rpx; }

.partner { display: flex; align-items: center; gap: 18rpx; }
.dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: #22c55e; box-shadow: 0 0 10rpx rgba(34,197,94,.8); }
.love-line { text-align: center; font-size: 22rpx; color: var(--text-dim); margin-top: 20rpx; }

.invite {
  background: linear-gradient(135deg, var(--brand), var(--brand-2));
  border-radius: var(--r-sm);
  color: #fff; text-align: center;
  padding: 24rpx;
  display: flex; flex-direction: column; gap: 6rpx;
}
.i-label { font-size: 22rpx; opacity: .9; }
.i-code { font-size: 52rpx; font-weight: 900; letter-spacing: 14rpx; }
.i-hint { font-size: 20rpx; opacity: .85; }

.foot { text-align: center; font-size: 20rpx; color: var(--text-dim); margin-top: 20rpx; }

.invite-actions { display: flex; gap: 14rpx; margin-top: 16rpx; justify-content: center; }
.invite-actions .btn { flex: 1; }

.mig-card { display: flex; align-items: center; gap: 18rpx; }
.mig-emoji { font-size: 48rpx; }
.mig-main { flex: 1; min-width: 0; }
.mig-title { font-size: 27rpx; font-weight: 800; }
.mig-sub { font-size: 21rpx; color: var(--text-dim); margin-top: 4rpx; }

.qr-sheet { display: flex; flex-direction: column; align-items: center; }
.qr-img { width: 420rpx; height: 420rpx; margin: 10rpx 0 16rpx; background: #fff; border-radius: 20rpx; }
.qr-hint { font-size: 22rpx; color: var(--text-dim); margin-bottom: 20rpx; }
.close-btn { margin-top: 14rpx; }

.mask {
  position: fixed; inset: 0;
  background: rgba(30, 12, 24, .45);
  z-index: 100;
  display: flex; align-items: flex-end;
}
.sheet {
  width: 100%; background: var(--bg);
  border-radius: 30rpx 30rpx 0 0;
  padding: 34rpx 34rpx calc(34rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.sheet-title { text-align: center; font-size: 30rpx; font-weight: 800; margin-bottom: 24rpx; }
.avatar-edit { display: flex; flex-direction: column; align-items: center; gap: 8rpx; margin-bottom: 20rpx; }
.avatar-tip { font-size: 20rpx; color: var(--text-dim); }
